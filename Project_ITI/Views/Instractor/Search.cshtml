@model List<INstractorDeptCourse>
@{
    ViewData["Title"] = "Search";
}

<h1>Search</h1>

<table class="table table-hover text-center">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Image</th>
            <th scope="col">Name</th>
            <th scope="col">Salary</th>
            <th scope="col">Address</th>
            <th scope="col">Department</th>
            <th scope="col">Course</th>
            <th scope="col">Details</th>
            <th scope="col">Edit</th>
            @* <th scope="col" style="color:red">Delete</th> *@
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">@(i++)</td>
                <td class="text-center"> <img class="card-img-top" style="width:100px;" src="/Images/@item.ImagUrl" alt="Card image "></td>
                <td class="text-center">@item.Name</td>
                <td class="text-center">@item.Salary</td>
                <td class="text-center">@item.Address</td>
                <td class="text-center">@item.DepartmentName</td>
                <td class="text-center">@item.CourseName</td>
                <td class="text-center"><a href="https://localhost:7069/Instractor/Details?id=@item.Id">Details</a> </td>
                <td class="text-center"><a href="https://localhost:7069/Instractor/Edit?id=@item.Id">Edit</a> </td>
                @* <td class="text-center"><a href="#" onclick="confirmDelete(@item.Id)">Delete</a> </td> *@

            </tr>
        }

    </tbody>
</table>


