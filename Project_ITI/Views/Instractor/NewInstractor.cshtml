@model InstractorWithDeptAndCourseListModelView
@{
    ViewData["Title"] = "NewInstractor";
}


<form method="post" action="/Instractor/SaveNew">
   
    <div>
        <label for="ImagUrl">Imag</label>
        <input type="text" id="ImagUrl" name="ImagUrl" value="@Model.ImagUrl" class="form form-control" />
    </div>
    <div>
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" value="@Model.Name" class="form form-control" />
    </div>
    <div>
        <label for="Salary">Salary</label>
        <input type="number" id="Salary" name="Salary" value="@Model.Salary" class="form form-control" />
    </div>
    <div>
        <label for="Address">Address</label>
        <input type="text" id="Address" name="Address" value="@Model.Address" class="form form-control" />
    </div>

    <div>
        <label for="DepartmentId">Department Id</label>
        <select id="DepartmentId" name="DepartmentId" class="form form-control">
            @foreach (Department depItem in Model.DepartmentList)
            {
                if (Model.Id == depItem.Id)
                {
                    <option value="@depItem.Id" selected>@depItem.Name</option>
                }
                else
                {
                    <option value="@depItem.Id">@depItem.Name</option>

                }


            }
        </select>

    </div>

    <div>
        <label for="CourseId">Course Id</label>
        <select id="CourseId" name="CourseId" class="form form-control">
            @foreach (Course courseItem in Model.CourseList)
            {
                if (Model.Id == courseItem.Id)
                {
                    <option value="@courseItem.Id" selected>@courseItem.Name</option>
                }
                else
                {
                    <option value="@courseItem.Id">@courseItem.Name</option>

                }
            }
        </select>

    </div>
    <input type="submit" value="Save" class="btn btn-success" />
</form>
<a href="/Instractor/Index">Back To List</a>



