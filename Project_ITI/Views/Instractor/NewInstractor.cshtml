@model InstractorWithDeptAndCourseListModelView
@{
    ViewData["Title"] = "NewInstractor";
}


<form method="post" action="/Instractor/SaveNew" enctype="multipart/form-data">

    <div>
        <label asp-for="ImgFom"></label>
        <input class="form form-control" asp-for="ImgFom" accept="image/jpg" />
        <span asp-validation-for="ImgFom" class="text-danger"></span>
    </div>
    <div>
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" value="@Model.Name" class="form form-control" />
    </div>
    <div>
        <label for="Salary">Salary</label>
        <input type="number" id="Salary" name="Salary" value="@Model.Salary" class="form form-control" />
    </div>
    <div>
        <label for="Address">Address</label>
        <input type="text" id="Address" name="Address" value="@Model.Address" class="form form-control" />
    </div>

   <div>
    <label for="DepartmentId">Department</label>
    <select id="DepartmentId" name="DepartmentId" class="form form-control">
        <option value="">--  Selecteed Department --</option>
        @foreach (Department depItem in Model.DepartmentList)
        {
                <option value="@depItem.Id" selected="@(Model.DepartmentId == depItem.Id ? "selected" : null)">
                    @depItem.Name
                </option>
        }
    </select>
</div>

<div>
    <label for="CourseId">Course</label>
    <select id="CourseId" name="CourseId" class="form form-control">
        <option value="">--Selected Course  --</option>
        @foreach (Course courseItem in Model.CourseList)
        {
                <option value="@courseItem.Id" selected="@(Model.CourseId == courseItem.Id ? "selected" : null)">
                    @courseItem.Name
                </option>
        }
    </select>
</div>

    <input type="submit" value="Save" class="btn btn-success" />
</form>
<a href="/Instractor/Index">Back To List</a>



//AJAX

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#DepartmentId").change(function () {
            var departmentId = $(this).val();
            console.log(departmentId);
            if (departmentId) {
                $.ajax({
                    url: `/Instractor/GetCoursesByDepartment?departmentId=${departmentId}`,
                    success: function (data) {
                        var courseDropdown = $("#CourseId");
                        courseDropdown.empty();
                        courseDropdown.append('<option value="">--  Selected Course --</option>');
                        $.each(data, function (index, course) {

                            courseDropdown.append('<option value="' + course.id + '">' + course.name + '</option>');
                        });
                    }
                });
            } else {
                $("#CourseId").empty().append('<option value="">-- Selected Course --</option>');
            }
        });
    });


</script>




